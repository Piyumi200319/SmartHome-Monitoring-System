<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_marginBottom="10dp" app:cardCornerRadius="18dp" app:cardElevation="3dp" app:cardBackgroundColor="@android:color/white" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <com.google.android.material.card.MaterialCardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#EEF2FF" app:cardElevation="0dp">
            <ImageView android:id="@+id/imgNotificationIcon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp" android:src="@drawable/ic_notifications_modern" android:contentDescription="Notification"/>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Device Alert" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/textPrimary"/>
            <TextView android:id="@+id/txtMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Your device has been turned on." android:textSize="14sp" android:textColor="#475569"/>
            <TextView android:id="@+id/txtTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Just now" android:textSize="12sp" android:textColor="#94A3B8"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>