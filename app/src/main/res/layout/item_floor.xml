<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
    app:cardCornerRadius="20dp" app:cardElevation="4dp" app:cardBackgroundColor="@android:color/white" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="56dp" android:layout_height="56dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#EEF2FF" app:cardElevation="0dp">
            <ImageView android:id="@+id/imgFloorIcon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:src="@drawable/ic_home_modern" android:contentDescription="Floor icon"/>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
            <TextView android:id="@+id/txtFloorName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ground Floor" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/textPrimary"/>
            <TextView android:id="@+id/txtRoomCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="3 Rooms" android:textSize="13sp" android:textColor="#64748B"/>
        </LinearLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron_right" android:rotation="0" android:alpha="0.45" android:contentDescription="Open floor"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>